# MARS AI Webapp Environment Variables

# Razorpay Public Key ID (starts with rzp_test_ or rzp_live_)
# Replace "rzp_test_dummy" with your real Razorpay Key ID once KYC is active.
# If left as "rzp_test_dummy", the onboarding page runs in interactive offline simulator mode.
VITE_RAZORPAY_KEY_ID=rzp_test_dummy
